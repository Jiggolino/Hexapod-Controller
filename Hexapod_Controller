#!/bin/bash
# Start the controller. Uses the virtual environment in .venv if there is one,
# otherwise the system python3. All arguments are passed on (see --help).
DIR="$(dirname "$(readlink -f "$0")")"
if [ -x "$DIR/.venv/bin/python" ]; then
    exec "$DIR/.venv/bin/python" "$DIR/hexapod_control.py" "$@"
fi
exec python3 "$DIR/hexapod_control.py" "$@"
